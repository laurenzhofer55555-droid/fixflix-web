# Leave empty for local development: the funnels then post to the ASP.NET API
# (/api/leads, proxied by `npm run dev`). Fill in to store leads in Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sub-path when served from GitHub project pages, e.g. /fixflix/ (CI sets this).
VITE_BASE=/

# Optional Plausible analytics.
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_HOST=
